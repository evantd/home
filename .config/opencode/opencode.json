{
	"$schema":       "https://opencode.ai/config.json",
	"model":         "llama-server/qwen3.6",
	"default_agent": "assistant",
	"instructions": [
		"instructions/common.md"
	],
	"enabled_providers": [
		"llama-server"
	],
	"provider": {
		"llama-server": {
			"npm":  "@ai-sdk/openai-compatible",
			"name": "llama-server Local",
			"options": {
				"baseURL": "http://localhost:{env:LLAMA_INFERENCE_PORT}/v1"
			},
			"models": {
				"qwen3-coder-next": {
					"name": "qwen3-coder-next UD-Q3 🚀 Agentic Coding",
					"limit": {
						"context": 262144,
						"output":  32768
					}
				},
				"qwen3.6": {
					"name": "qwen3.6-35B UD-Q4 🧠 Multimodal/Thinking",
					"limit": {
						"context": 262144,
						"output":  32768
					}
				}
			}
		}
	},
	"mcp": {"mcp-optimizer": {"url": "http://localhost:50206/mcp", "type": "remote"}}
}
